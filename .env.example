# LiveKit Cloud or Self-Hosted Server Configuration
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini API Key (for LLM reasoning & response generation)
GEMINI_API_KEY=your_gemini_api_key

# Local STT Configuration (faster-whisper - zero API cost)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local TTS Configuration (Piper - zero API cost)
PIPER_VOICE=en_US-lessac-medium
# Optional custom paths:
# PIPER_MODEL_PATH=/path/to/voice.onnx
# PIPER_CONFIG_PATH=/path/to/voice.onnx.json

# Agent Configuration
AGENT_NAME=zcloud-ai-telecaller-agent
AGENT_LOG_LEVEL=INFO
