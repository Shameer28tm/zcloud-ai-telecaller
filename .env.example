# LiveKit Cloud or Self-Hosted Server Configuration
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini API Key and Live Multimodal Voice Model
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-live
USE_REALTIME_AUDIO=true

# Local STT Configuration (faster-whisper - zero API cost)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local TTS Configuration (Piper - zero API cost)
PIPER_VOICE=en_US-lessac-medium
# Optional custom paths:
# PIPER_MODEL_PATH=/path/to/voice.onnx
# PIPER_CONFIG_PATH=/path/to/voice.onnx.json

# Sarvam AI API Key (for native Indic / Tamil Bulbul TTS & Saaras STT)
# SARVAM_API_KEY=your_sarvam_api_key

# Agent Configuration
AGENT_NAME=zcloud-ai-telecaller-agent
AGENT_LOG_LEVEL=INFO
# LIVEKIT_AGENT_DEPLOYMENT=production # Optional: match LiveKit Cloud hosted deployment tag

# Control Plane Integration (Phase 2A)
CONTROL_PLANE_URL=http://localhost:3000
WORKER_API_SECRET=your_worker_api_secret

# Phase 4 Telephony / LiveKit SIP Configuration (India / Mumbai ap-south)
# Note: For Indian PSTN compliance (TRAI media anchoring), use your LiveKit India SIP FQDN:
# e.g. {project-subdomain}.india.sip.livekit.cloud
LIVEKIT_SIP_URI=sip.livekit.cloud
SIP_SIMULATION_MODE=true # Set to false when live PSTN credentials and carrier trunk are provisioned
